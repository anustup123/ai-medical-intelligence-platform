# Copy this file to .env and fill in your own values.
# Never commit your real .env file to GitHub.

# Required for the LLM-generated report feature.
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY= 

# Which Claude model to use for report generation.
LLM_MODEL=claude-sonnet-4-6

# Database connection string.
# Default (SQLite, no setup needed):
DATABASE_URL=sqlite:///predictions.db
# Example for PostgreSQL instead:
# DATABASE_URL=postgresql://user:password@host:5432/mediai
